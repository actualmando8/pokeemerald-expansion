RuinsOfAlph_Outside_Text_Fisher1:
	.string "These ruins are ancient.\n"
	.string "Nobody knows who built them.$"

RuinsOfAlph_Outside_Text_Fisher2:
	.string "I fish in the stream nearby.\n"
	.string "Sometimes strange tiles wash\l"
	.string "up from the ruins...$"

RuinsOfAlph_Outside_Text_Nathan:
	.string "I'm researching the UNOWN\n"
	.string "that inhabit these ruins.\p"
	.string "They seem to be some kind\n"
	.string "of ancient alphabet.$"

RuinsOfAlph_Outside_Text_Sign1:
	.string "RUINS OF ALPH\n"
	.string "An ancient mystery awaits.$"

RuinsOfAlph_Outside_Text_Sign2:
	.string "RESEARCH CENTER ahead.\n"
	.string "Scientists welcome visitors.$"

RuinsOfAlph_Outside_Text_Sign3:
	.string "PUZZLE CHAMBERS this way.\n"
	.string "Solve the puzzles to\l"
	.string "discover UNOWN.$"

RuinsOfAlph_Outside_Text_Stan:
	.string "I came here to see the UNOWN\n"
	.string "but the puzzles are hard!\p"
	.string "You have to slide the tiles\n"
	.string "into the right places.$"

RuinsOfAlph_Outside_Text_Youngster1:
	.string "UNOWN are shaped like letters!\n"
	.string "I want to catch all 26!$"

RuinsOfAlph_Outside_Text_Youngster2:
	.string "The scientists say these ruins\n"
	.string "are thousands of years old!\p"
	.string "Imagine all the POKeMON that\n"
	.string "lived back then!$"

